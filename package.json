{
    "name":  "spotify-overlay",
    "productName":  "Spotify Overlay",
    "version":  "1.0.0",
    "description":  "Press F8 in any game for a small Spotify overlay: song, time left, controls and your playlists.",
    "main":  "main.js",
    "author":  "Collin Chandler",
    "private":  true,
    "scripts":  {
                    "start":  "electron .",
                    "dist":  "electron-builder --win portable"
                },
    "devDependencies":  {
                            "electron":  "^31.0.0",
                            "electron-builder":  "^24.13.3"
                        },
    "build":  {
                  "appId":  "com.collin.spotifyoverlay",
                  "productName":  "Spotify Overlay",
                  "files":  [
                                "main.js",
                                "preload.js",
                                "spotify-api.js",
                                "globe.js",
                                "overlay.html",
                                "corner.html",
                                "settings.html",
                                "media-helper.ps1",
                                "icon.png",
                                "watcher/SpotifyOverlayWatcher.exe",
                                "watcher/SpotifyOverlayKeys.exe",
                                "sounds/open.wav",
                                "sounds/close.wav",
                                "media/stars-strip.mp4",
                                "media/stars-globe.mp4",
                                "media/frame.png",
                                "media/keys/*.png",
                                "fonts/DSEG14Classic-Bold.woff2",
                                "fonts/DSEG14Classic-Regular.woff2",
                                "fonts/DSEG-LICENSE.txt"
                            ],
                  "asarUnpack":  [
                                   "watcher/SpotifyOverlayKeys.exe"
                               ],
                  "extraResources":  [
                                         {
                                             "from":  "media-helper.ps1",
                                             "to":  "media-helper.ps1"
                                         }
                                     ],
                  "win":  {
                              "target":  "portable",
                              "icon":  "icon.png"
                          }
              }
}